{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "lib": [
            "ES2020"
        ],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": false,
        "sourceMap": true,
        "noImplicitAny": false,
        "moduleResolution": "node",
        "typeRoots": [
            "./node_modules/@types"
        ],
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "src/check-anup.ts",
        "src/fix-categories.ts",
        "src/fix-future-past.ts",
        "src/force-fix.ts",
        "src/revert-recent.ts",
        "src/verify-sorting-fix.ts",
        "src/add-all-upcoming.ts",
        "src/add-upcoming.ts",
        "src/check-and-fix-images.ts",
        "src/fix-podcasts.ts",
        "src/fix-upcoming-proper.ts",
        "src/import-podcasts.ts",
        "src/import-to-production.ts", // CHANGE HERE
        "src/populate-podcast-images.ts",
        "src/test-db-connection.ts",
        "src/scripts/**/*"
    ]
}